# Copy to .env and fill in. Never commit .env.

# NVR / cameras
NVR_USER=viewer
NVR_PASSWORD=change-me

# ERP outbound API
ERP_BASE_URL=https://erp.example.com
ERP_API_TOKEN=replace-with-api-token

# Local audit DB (pilot)
DATABASE_URL=postgresql://idle_agent:change-me@127.0.0.1:5432/idle_events

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
